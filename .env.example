# Local development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
ENABLE_DEV_BILLING=true
DATABASE_URL=sqlite:///./trading_journal.db
UPLOAD_DIR=./uploads
ALLOWED_HOSTS=*
SESSION_HTTPS_ONLY=false

